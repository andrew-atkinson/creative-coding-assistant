# Copy to .env and fill in real values. Never commit .env.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# --- LLM (OpenAI-compatible endpoint) ---
# Local dev (LM Studio):
#   LLM_BASE_URL=http://localhost:1234/v1
#   LLM_API_KEY=lmstudio
#   LLM_MODEL=<the model id shown in LM Studio, e.g. unsloth-gemma-4-26b-a4b-it-qat-oq4>
# Hosted (Groq free tier):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lmstudio
LLM_MODEL=
# Optional: separate (usually smaller) model for the routing pass.
# Falls back to LLM_MODEL when empty.
LLM_ROUTER_MODEL=

# --- Context budget ---
# Cap per-turn context to stay within free-tier LLM per-request token limits
# (e.g. Groq free tier 12k tokens/req on llama-3.3-70b). Defaults in code:
# 2 lessons per turn, 8000 chars per lesson. Leave empty to keep defaults; set
# larger values if your LLM has a bigger budget (local LM Studio, paid tier).
MAX_LESSONS_PER_TURN=
MAX_LESSON_CHARS=

# --- M1 admin auth (shared secret; swapped for Supabase JWT in M2) ---
ADMIN_SECRET=

# --- Storage backend ---
# "static-webhook" (default): course from data/course.json, feedback via email
#   or webhook — no DB. "supabase": use the Postgres path (local Docker or
#   hosted). Restart `pnpm dev` after changing.
STORAGE_BACKEND=static-webhook

# --- Feedback delivery (only used by the static-webhook backend) ---
# "email" (Resend) or "webhook" (Discord/Slack/generic HTTPS). Default: webhook.
FEEDBACK_MODE=email

# For FEEDBACK_MODE=email: sign up at resend.com, create an API key, verify a
# sending domain (or use onboarding@resend.dev for testing). Free tier: 3k/mo.
RESEND_API_KEY=
FEEDBACK_EMAIL_TO=
FEEDBACK_EMAIL_FROM=

# For FEEDBACK_MODE=webhook: Discord/Slack incoming webhook URL, or any HTTPS
# endpoint that accepts { "content": "..." } JSON.
FEEDBACK_WEBHOOK_URL=

# --- Runtime origin (used for CORS + client links). Config-driven, not hardcoded. ---
PUBLIC_RUNTIME_ORIGIN=http://localhost:5173
